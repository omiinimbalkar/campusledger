PORT=3000
DATABASE_FILE=./data/ledger.db
# Optional demo account overrides. Defaults: admin/admin123 and student/student123.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123
DEMO_STUDENT_USERNAME=student
DEMO_STUDENT_PASSWORD=student123
# Optional stable signing secret; generate a long random value before deployment.
SESSION_SECRET=
# Optional one-way full snapshot export to a Google Sheet. Create a tab named Ledger.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""
